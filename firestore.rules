rules_version = '2';

// ============================================================
// Qube – Firestore biztonsági szabályok
// Firebase konzol → Firestore Database → Rules: ide másold be, majd Publish.
//
// Elvek:
// - Mindenki névtelen Firebase azonosítóval ér el (Anonymous Auth).
// - A jogosultság a users/{uid}.role mezőből és a roles/{role}.permissions
//   listából jön. Az 'admin' szerepkör mindig mindent elér.
// - Új felhasználó csak 'operator'-ként jöhet létre, a szerepkörét
//   maga nem írhatja át.
// - Minden, ami itt nincs kifejezetten engedélyezve, tiltott.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Segédfüggvények ----------
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function rolePath(role) { return /databases/$(database)/documents/roles/$(role); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function recoveryPath(h) { return /databases/$(database)/documents/recoveryCodes/$(h); }

    function active() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && me().status == 'active';
    }
    function isAdmin() { return active() && me().role == 'admin'; }
    function can(perm) {
      return active()
        && (me().role == 'admin' || perm in get(rolePath(me().role)).data.permissions);
    }

    function validName(n) { return n is string && n.size() >= 3 && n.size() <= 60; }
    // Ugyanaz a minta, mint a js/config.js EMP_ID_PATTERN-je!
    function validEmpId(e) { return e is string && e.matches('^[0-9]{3,10}$'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- Felhasználók ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || can('users.view'));

      // Regisztráció: csak saját magát, operátorként.
      // 'active' csak akkor lehet, ha ugyanabban a batch-ben a törzsszámot is lefoglalta.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'empId', 'role', 'status', 'createdAt', 'lastActive'])
        && validName(request.resource.data.name)
        && validEmpId(request.resource.data.empId)
        && request.resource.data.role == 'operator'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActive == request.time
        && (
          request.resource.data.status == 'conflict'
          || (request.resource.data.status == 'active'
              && getAfter(/databases/$(database)/documents/empIds/$(request.resource.data.empId)).data.uid == uid)
        );

      allow update: if
        // 1) Saját magának: csak név és "utoljára aktív"
        (signedIn() && request.auth.uid == uid
          && changed().hasOnly(['name', 'lastActive'])
          && validName(request.resource.data.name)
          && (!('lastActive' in changed()) || request.resource.data.lastActive == request.time))
        // 2) Admin: bármit
        || isAdmin()
        // 3) Vezető (users.manage): nem-admin fiók szerepköre és aktív/letiltott állapota
        || (can('users.manage')
          && request.auth.uid != uid
          && resource.data.role != 'admin'
          && request.resource.data.role != 'admin'
          && resource.data.status in ['active', 'disabled']
          && request.resource.data.status in ['active', 'disabled']
          && changed().hasOnly(['role', 'status'])
          && exists(rolePath(request.resource.data.role)))
        // 4) Admin vészkijárat: összekapcsolásra váró fiók egy egyszer használatos
        //    vészkóddal (a kód ugyanebben a lépésben törlődik) visszaveszi az admin jogot
        || (signedIn() && request.auth.uid == uid
          && resource.data.status == 'conflict'
          && changed().hasOnly(['role', 'status', 'recoveredWith'])
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'active'
          && request.resource.data.recoveredWith is string
          && request.resource.data.recoveredWith.matches('^[0-9a-f]{64}$')
          && exists(recoveryPath(request.resource.data.recoveredWith))
          && get(recoveryPath(request.resource.data.recoveredWith)).data.empId == resource.data.empId
          && !existsAfter(recoveryPath(request.resource.data.recoveredWith)));

      allow delete: if isAdmin();
    }

    // ---------- Törzsszám foglalás (egyediség) ----------
    match /empIds/{empId} {
      allow get: if signedIn();

      // Regisztrációkor: a saját, éppen létrejövő aktív profiljához
      allow create: if signedIn() && validEmpId(empId)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.empId == empId
        && getAfter(userPath(request.auth.uid)).data.status == 'active';

      // Összekapcsolás, javítás, törlés: admin
      allow create, update, delete: if isAdmin() && validEmpId(empId);

      // Admin vészkijárat: a vészkóddal visszaállított fiók átveszi a saját törzsszámát
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && get(userPath(request.auth.uid)).data.status == 'conflict'
        && getAfter(userPath(request.auth.uid)).data.empId == empId
        && getAfter(userPath(request.auth.uid)).data.status == 'active'
        && getAfter(userPath(request.auth.uid)).data.role == 'admin'
        && exists(recoveryPath(getAfter(userPath(request.auth.uid)).data.recoveredWith))
        && !existsAfter(recoveryPath(getAfter(userPath(request.auth.uid)).data.recoveredWith));
    }

    // ---------- Admin vészkódok ----------
    // A dokumentum azonosítója a kód SHA-256 lenyomata – maga a kód sehol nincs tárolva.
    // Nem-admin nem olvashatja (a szabályok ettől még ellenőrizni tudják).
    match /recoveryCodes/{h} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && h.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['empId', 'createdAt'])
        && validEmpId(request.resource.data.empId)
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin()
        || (signedIn()
          && resource.data.empId == get(userPath(request.auth.uid)).data.empId
          && get(userPath(request.auth.uid)).data.status == 'conflict'
          && getAfter(userPath(request.auth.uid)).data.recoveredWith == h);
    }

    // ---------- Szerepkörök ----------
    match /roles/{roleId} {
      allow read: if signedIn();
      allow delete: if isAdmin() && roleId != 'admin' && roleId != 'operator';
      allow create, update: if isAdmin()
        && roleId.matches('^[a-z][a-z0-9_]{1,29}$')
        && request.resource.data.keys().hasOnly(['label', 'rank', 'permissions'])
        && request.resource.data.label is string
        && request.resource.data.rank is int
        && request.resource.data.permissions is list;
    }

    // ============================================================
    // IC GENERÁTOR
    // ============================================================
    function validArea(a) { return a in ['ESS', 'WSS']; }
    function validAmount(n) { return n is int && n >= 1 && n <= 5000; }

    // IC lista – a dokumentum azonosítója maga a 13 karakteres IC szám
    match /ic_numbers/{code} {
      allow read: if can('ic.use');
      allow create, update: if can('ic.manage')
        && code.matches('^[A-Z0-9]{13}$')
        && request.resource.data.keys().hasOnly(['code', 'area', 'createdAt', 'createdBy'])
        && request.resource.data.code == code
        && validArea(request.resource.data.area)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if can('ic.manage');
    }

    // Generálási napló – csak létrehozható, módosítani nem lehet
    match /ic_logs/{id} {
      allow create: if can('ic.use')
        && request.resource.data.keys().hasOnly(['icCode', 'area', 'amount', 'uid', 'name', 'empId', 'clientTime', 'day', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.icCode.matches('^[A-Z0-9]{13}$')
        && validArea(request.resource.data.area)
        && validAmount(request.resource.data.amount)
        && request.resource.data.ts == request.time;
      // Saját napló ellenőrzése (újraküldésnél: felment-e már)
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if can('ic.stats');
      allow delete: if isAdmin();
    }

    // Napi (d_ÉÉÉÉ-HH-NN) és havi (m_ÉÉÉÉ-HH) összesítők – csak növelhetők
    match /ic_stats/{id} {
      allow read: if can('ic.stats');
      allow create: if can('ic.use')
        && id.matches('^(d_[0-9]{4}-[0-9]{2}-[0-9]{2}|m_[0-9]{4}-[0-9]{2})$')
        && request.resource.data.keys().hasOnly(['count', 'amount', 'byIc'])
        && request.resource.data.count == 1
        && validAmount(request.resource.data.amount);
      allow update: if can('ic.use')
        && request.resource.data.keys().hasOnly(['count', 'amount', 'byIc'])
        && request.resource.data.count == resource.data.count + 1
        && validAmount(request.resource.data.amount - resource.data.amount);
    }

    // ============================================================
    // BEÁLLÍTÁSOK (adventi naptár stb.) – mindenki olvassa, csak admin írja
    // ============================================================
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ============================================================
    // VISSZAJELZÉSEK (hiba / ötlet) – a beküldő a sajátját látja, az admin mindet
    // ============================================================
    match /feedback/{id} {
      allow create: if active()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'empId', 'type', 'module', 'text', 'status', 'createdAt', 'clientTime', 'version', 'device'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['bug', 'idea']
        && request.resource.data.module is string && request.resource.data.module.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      // saját: get (újraküldés-ellenőrzés) és lista (where uid == saját)
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt'])
        && request.resource.data.status in ['new', 'progress', 'done', 'rejected'];
      allow delete: if isAdmin();
    }

    // ============================================================
    // MUNKAIDŐ NAPTÁR – szabadságok (mindenki látja), éves keret (csak a saját)
    // ============================================================
    match /leave/{uid} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'days', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.days is list && request.resource.data.days.size() <= 400
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /leaveQuota/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if active() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['quota'])
        && request.resource.data.quota is map;
    }

    // ============================================================
    // PROFILKÉPEK – kicsinyített JPEG a dokumentumban + egy közös index
    // A kép és az index csak együtt (egy batch-ben) változhat.
    // Az admin a Beállításokban kikapcsolhatja, és bárkiét törölheti.
    // ============================================================
    function avatarPath(uid) { return /databases/$(database)/documents/avatars/$(uid); }
    function avatarIndexPath() { return /databases/$(database)/documents/meta/avatars; }
    function settingsPath() { return /databases/$(database)/documents/settings/app; }
    function avatarsOn() {
      return !exists(settingsPath())
        || get(settingsPath()).data.get('avatars', {}).get('enabled', true) == true;
    }

    match /avatars/{uid} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == uid && avatarsOn()
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 40000
        && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.updatedAt == request.time
        // legfeljebb 20 mp-enként egy csere
        && (resource == null || request.time > resource.data.updatedAt + duration.value(20, 's'))
        && getAfter(avatarIndexPath()).data[uid] == request.time;
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    match /meta/avatars {
      allow read: if active();
      // Saját kulcs: beállítás a kép feltöltésével együtt, vagy törlés a kép törlésével együtt
      allow create: if active()
        && request.resource.data.keys().hasOnly([request.auth.uid])
        && request.resource.data[request.auth.uid] == request.time
        && getAfter(avatarPath(request.auth.uid)).data.updatedAt == request.time;
      allow update: if isAdmin()
        || (active()
          && changed().hasOnly([request.auth.uid])
          && (request.auth.uid in request.resource.data
              ? (request.resource.data[request.auth.uid] == request.time
                 && getAfter(avatarPath(request.auth.uid)).data.updatedAt == request.time)
              : !existsAfter(avatarPath(request.auth.uid))));
    }

    // ============================================================
    // HASZNÁLATI STATISZTIKA – mindenki csak a saját napi összesítőjét írhatja,
    // olvasni (és takarítani) csak az admin tudja
    // ============================================================
    function validDay(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    match /usage/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if active()
        && request.resource.data.uid == request.auth.uid
        && validDay(request.resource.data.day)
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'modules', 'actions', 'errors', 'hours', 'sessions', 'time', 'last', 'device', 'log'])
        && (!('log' in request.resource.data) || request.resource.data.log.size() <= 600);
    }

    match /usageDaily/{day} {
      allow read, delete: if isAdmin();
      allow create: if active() && validDay(day)
        && request.resource.data.keys().hasOnly(['modules', 'actions', 'errors', 'hours', 'sessions', 'time', 'users'])
        && request.resource.data.users.keys().hasOnly([request.auth.uid]);
      allow update: if active()
        && request.resource.data.keys().hasOnly(['modules', 'actions', 'errors', 'hours', 'sessions', 'time', 'users'])
        && request.resource.data.users.diff(resource.data.get('users', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    // ---------- Modulok (következő lépésekben) ----------
    // MES terminál, csomagoló kód
  }
}
